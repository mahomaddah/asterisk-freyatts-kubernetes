    "orientation": "horizontal"
   }
  },
  {
   "type": "row",
   "title": "GPU node (GTX 1050, time-sliced x4)",
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "GPU temperature",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "nvidia_smi_temperature_gpu",
     "legendFormat": "GTX 1050",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      },
      "spanNulls": true,
      "showPoints": "always",
      "pointSize": 6,
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "This laptop hard-powers-off near 93 C"
  },
  {
   "type": "timeseries",
   "title": "GPU utilisation",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "nvidia_smi_utilization_gpu_ratio",
     "legendFormat": "GTX 1050",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "spanNulls": true,
      "showPoints": "always",
      "pointSize": 6,
      "lineWidth": 2
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "GPU memory (4 GB shared by TTS + STT)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "nvidia_smi_memory_used_bytes",
     "legendFormat": "used",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "nvidia_smi_memory_total_bytes",
     "legendFormat": "total",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "spanNulls": true,
      "showPoints": "always",
      "pointSize": 6,
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {}
  }
 ],
 "timezone": "browser"
}