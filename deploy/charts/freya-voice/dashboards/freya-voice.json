   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal"
   }
  },
  {
   "type": "bargauge",
   "title": "Warm transfers",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 15,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "round(sum by (result) (increase(agent_transfers_total[$__range])))",
     "legendFormat": "{{result}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
